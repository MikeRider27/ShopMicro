# Copia este archivo a .env y completa TODOS los valores marcados como
# obligatorios antes de levantar el stack. Los microservicios se niegan a
# arrancar si falta alguna variable requerida (fail-fast), en vez de usar
# valores por defecto inseguros.

# --- Postgres ---------------------------------------------------------------
# Por defecto se usa el contenedor "postgres" incluido en docker-compose.yml
# (con volumen persistente), así el proyecto no depende de ningún servidor
# externo para funcionar. Si preferís apuntar a un Postgres externo ya
# existente, cambiá POSTGRES_HOST/POSTGRES_PORT y quitá el servicio
# "postgres" (y sus "depends_on") de docker-compose.yml.
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
# OBLIGATORIO: usuario y contraseña reales, no dejar el ejemplo tal cual.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme-strong-password

# Bases de datos por microservicio (ver docker/postgres-initdb/01-create-databases.sh)
AUTH_DB_NAME=ecommerce_auth
PRODUCTS_DB_NAME=ecommerce_products
ORDERS_DB_NAME=ecommerce_orders

# --- Seguridad ---------------------------------------------------------------
# OBLIGATORIO: generar un secreto fuerte, por ejemplo con:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=changeme-generate-a-strong-random-secret
JWT_ACCESS_TOKEN_EXPIRES_MINUTES=60

# OBLIGATORIO: clave para los endpoints de administración de product-service
# (POST/PUT/DELETE /products). Generarla igual que el JWT_SECRET_KEY.
ADMIN_API_KEY=changeme-generate-a-strong-random-key

# OBLIGATORIO: orígenes permitidos para CORS, separados por coma (sin espacios
# extra). Debe incluir la URL pública del frontend.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- Puertos expuestos en el host (ajustar si ya están en uso) --------------
GATEWAY_PORT=8080
FRONTEND_PORT=3000

# --- Frontend ----------------------------------------------------------------
NEXT_PUBLIC_API_URL=http://localhost:8080
