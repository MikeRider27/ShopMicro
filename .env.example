# Postgres externo compartido
POSTGRES_HOST=192.168.11.220
POSTGRES_PORT=5436
POSTGRES_USER=postgres
POSTGRES_PASSWORD=123

# Bases de datos por microservicio (ver init-db.sql)
AUTH_DB_NAME=ecommerce_auth
PRODUCTS_DB_NAME=ecommerce_products
ORDERS_DB_NAME=ecommerce_orders

# Seguridad
JWT_SECRET_KEY=change-me-in-production
ADMIN_API_KEY=change-me-in-production

# Puertos expuestos en el host (ajusta si ya están en uso)
GATEWAY_PORT=8080
FRONTEND_PORT=3000

# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8080
